# Copy this file to .env and adjust values as needed.

# Which provider to use: "openai" or "ollama"
MODEL_PROVIDER=ollama

# Model name for the chosen provider, e.g. "gpt-4o-mini" or "llama3.1"
MODEL_NAME=llama3.1

# Required when MODEL_PROVIDER=openai
OPENAI_API_KEY=

# Used when MODEL_PROVIDER=ollama (OpenAI-compatible endpoint)
OLLAMA_BASE_URL=http://localhost:11434/v1

# Used by the triage and handoff samples (native System One decisions endpoint)
SYSTEM_ONE_BASE_URL=http://localhost:11434/v1
# Optional bearer token for authenticated System One servers
SYSTEM_ONE_API_KEY=
